DATABASE_HOST='document_list_db'
DATABASE_PORT=17232
DATABASE_USER='document_list_user'
DATABASE_PASSWORD='document_list_pass'
DATABASE_NAME='document_list_primary'
DATABASE_USE_SSL='false'

REDIS_HOST='document-list-redis'
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD='document-list-redis-pass'
REDIS_USE_SSL=true

MIGRATOR_HOST='document-list-migrator'

# Snapshot del último padrón aplicado (baseline del diff del día siguiente)
MIGRATOR_SNAPSHOT_BUCKET='document-list-migrator-snapshots'
MIGRATOR_SNAPSHOT_REGION='us-east-1'
# MIGRATOR_SNAPSHOT_PREFIX=snapshots
# Solo S3 compatible fuera de AWS (MinIO en local)
# MIGRATOR_SNAPSHOT_ENDPOINT=http://minio:9000
# MIGRATOR_PADRON_URL=http://www2.sunat.gob.pe/padron_reducido_ruc.zip
# Fuera de ECS: credenciales estáticas
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Filas por transacción al aplicar el delta
MIGRATOR_SYNC_BATCH_ROWS=20000
# Tope de filas/s escritas en la BD (dni + ruc). 0 = sin límite
MIGRATOR_SYNC_MAX_ROWS_PER_SEC=20000
# Último recurso: delta contra un volcado de la BD en vez del snapshot de S3
MIGRATOR_FORCE_DATABASE_BASELINE=false
# Volcado de la BD (psql, por rangos de bloques físicos): bloques de 8 KB por consulta
# y tope de filas/s leídas (ambas tablas). 0 = sin límite
MIGRATOR_BASELINE_PAGE_BLOCKS=2048
MIGRATOR_BASELINE_MAX_ROWS_PER_SEC=100000
# Línea JSON {"event":"mem"} cada N ms para diagnosticar OOM. 0 = apagado
MIGRATOR_MEMORY_SAMPLE_MS=0

# sort externo (cuando el padrón no viene ordenado y para el volcado de la BD)
MIGRATOR_SORT_BUFFER=512M
MIGRATOR_SORT_PARALLEL=2

DOCKER_REGISTRY_URL="docker.io"
